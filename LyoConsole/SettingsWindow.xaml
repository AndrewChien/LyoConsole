<Window x:Class="LyoConsole.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="设置"
        Height="650"
        Width="1000"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl>
            <TabItem Header="程序">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0"
                              ItemsSource="{Binding Programs}"
                              SelectedItem="{Binding SelectedProgram}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              SelectionMode="Single"
                              SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="启动顺序" Binding="{Binding StartOrder}" Width="Auto" />
                            <DataGridTextColumn Header="启动间隔(ms)" Binding="{Binding StartDelayMs}" Width="Auto" />
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="Auto" />
                            <DataGridTextColumn Header="程序路径" Binding="{Binding FilePath}" Width="Auto" />
                            <DataGridTextColumn Header="参数" Binding="{Binding Arguments}" Width="Auto" />
                            <DataGridTextColumn Header="工作目录" Binding="{Binding WorkingDirectory}" Width="Auto" />
                            <DataGridTemplateColumn Header="输出编码" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding OutputEncoding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox IsEditable="False"
                                                  ItemsSource="{Binding DataContext.EncodingOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding OutputEncoding, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="添加程序" Command="{Binding AddProgramCommand}" Width="90" Margin="0,0,8,0" />
                        <Button Content="删除程序" Command="{Binding RemoveProgramCommand}" Width="90" Margin="0,0,8,0" />
                        <Button Content="程序路径..." Click="Browse_Click" Width="90" Margin="0,0,8,0" />
                    </StackPanel>

                    <TextBlock Grid.Row="2"
                               Margin="0,8,0,0"
                               Foreground="Gray"
                               TextWrapping="Wrap">
                        提示：启动顺序决定批量启动顺序；主界面可拖拽 Tab 调整显示顺序（不影响启动顺序）。
                    </TextBlock>
                </Grid>
            </TabItem>

            <TabItem Header="输出界面">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,10,8" VerticalAlignment="Center" Text="前景色:" />
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Text="{Binding Ui.OutputForeground, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,10,8" VerticalAlignment="Center" Text="背景色:" />
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Text="{Binding Ui.OutputBackground, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,10,8" VerticalAlignment="Center" Text="字体:" />
                    <ComboBox Grid.Row="2"
                              Grid.Column="1"
                              Margin="0,0,0,8"
                              IsEditable="True"
                              ItemsSource="{Binding FontFamilies}"
                              SelectedItem="{Binding Ui.OutputFontFamily}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,10,8" VerticalAlignment="Center" Text="字号:" />
                    <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" Text="{Binding Ui.OutputFontSize, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,10,10,8" VerticalAlignment="Top" Text="预览:" />
                    <TextBox Grid.Row="4"
                             Grid.Column="1"
                             Grid.RowSpan="2"
                             Margin="0,10,0,0"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Text="控制台输出预览...&#x0A;第2行&#x0A;第3行"
                             Foreground="{Binding Ui.OutputForeground}"
                             Background="{Binding Ui.OutputBackground}"
                             FontFamily="{Binding Ui.OutputFontFamily}"
                             FontSize="{Binding Ui.OutputFontSize}" />
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="保存" Width="100" Margin="0,0,8,0" IsDefault="True" Click="Save_Click" />
            <Button Content="取消" Width="100" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>

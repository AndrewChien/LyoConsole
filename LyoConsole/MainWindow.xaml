<Window x:Class="LyoConsole.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LyoConsole"
        xmlns:utils="clr-namespace:LyoConsole.Utilities"
        mc:Ignorable="d"
        Title="LyoConsole - 控制台控制器"
        Height="700"
        Width="1100">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="文件(_F)">
                <MenuItem Header="设置(_S)..." Command="{Binding OpenSettingsCommand}" />
                <Separator />
                <MenuItem Header="退出(_X)" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="工具(_T)">
                <MenuItem Header="全部启动(_A)" Command="{Binding StartAllCommand}" />
                <MenuItem Header="全部停止(_O)" Command="{Binding StopAllCommand}" />
            </MenuItem>
            <MenuItem Header="预留菜单1" />
            <MenuItem Header="预留菜单2" />
            <MenuItem Header="帮助(_H)">
                <MenuItem Header="关于(_A)" Click="About_Click" />
            </MenuItem>
        </Menu>

        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="全部启动" Command="{Binding StartAllCommand}" />
                <Button Content="全部停止" Command="{Binding StopAllCommand}" />
                <Separator />
                <Button Content="设置" Command="{Binding OpenSettingsCommand}" />
                <Button Content="端口管理器" Command="{Binding OpenPortManagerCommand}" />
                <Button Content="退出" Command="{Binding ExitCommand}" />
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding NowText}" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <TabControl ItemsSource="{Binding Programs}"
                        SelectedItem="{Binding SelectedProgram}"
                        utils:TabReorderBehavior.IsEnabled="True">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding TabHeader}" />
                    </DataTemplate>
                </TabControl.ItemTemplate>

                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Margin="8">
                                <Button Content="启动" Command="{Binding StartCommand}" Margin="0,0,8,0" />
                                <Button Content="停止" Command="{Binding StopCommand}" Margin="0,0,8,0" />
                                <Button Content="清空" Command="{Binding ClearOutputCommand}" />
                            </StackPanel>

                            <TextBox Grid.Row="1"
                                     Margin="8,0,8,8"
                                     Text="{Binding OutputText, Mode=OneWay}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     utils:TextBoxBehaviors.AutoScrollToEnd="True"
                                     Foreground="{Binding DataContext.Ui.OutputForeground, RelativeSource={RelativeSource AncestorType=Window}}"
                                     Background="{Binding DataContext.Ui.OutputBackground, RelativeSource={RelativeSource AncestorType=Window}}"
                                     FontFamily="{Binding DataContext.Ui.OutputFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                     FontSize="{Binding DataContext.Ui.OutputFontSize, RelativeSource={RelativeSource AncestorType=Window}}" />

                            <Grid Grid.Row="2" Margin="8,0,8,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SendInputCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Padding="16,4"
                                        Content="发送"
                                        Command="{Binding SendInputCommand}" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
